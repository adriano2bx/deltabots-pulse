# EXEMPLO. Não preencher com segredos reais nem fazer commit do .env
APP_ENV=local
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
PUBLIC_WS_BASE_URL=ws://127.0.0.1:8787/v1/realtime
JWT_SIGNING_PRIVATE_KEY=REPLACE_VIA_SECRET_MANAGER
JWT_VERIFY_PUBLIC_KEY=REPLACE_VIA_SECRET_MANAGER
OIDC_ISSUER_URL=REPLACE_IF_ENABLED
FCM_CREDENTIAL_REF=REPLACE_IF_ENABLED
EMAIL_PROVIDER_SECRET=REPLACE_IF_ENABLED
MCP_JEV_ENDPOINT=REPLACE_IF_AVAILABLE
MQTT_BROKER_URL=mqtts://localhost:8883
MQTT_BRIDGE_CLIENT_ID=bridge-dev
MQTT_BRIDGE_CLIENT_CERT_PATH=/run/secrets/mqtt_cert
MQTT_BRIDGE_CLIENT_KEY_PATH=/run/secrets/mqtt_key
