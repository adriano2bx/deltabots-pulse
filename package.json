{
  "name": "deltabots-pulse",
  "private": true,
  "version": "1.1.0",
  "description": "DeltaBots Pulse — plataforma de inteligência wearable (Android + Cloudflare + console + IoT).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "specs:check": "python3 quality/check_specs.py",
    "status": "python3 quality/status.py",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm specs:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
