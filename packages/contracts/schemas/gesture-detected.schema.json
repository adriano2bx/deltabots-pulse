{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GestureDetected",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gesture",
    "confidence",
    "model_version"
  ],
  "properties": {
    "gesture": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model_version": {
      "type": "string"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capture_monotonic_ns": {
      "type": "integer",
      "minimum": 0
    }
  }
}
