{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IoTMqttCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "command_id",
    "session_id",
    "equipment_id",
    "seq",
    "action",
    "idempotency_key",
    "expires_at"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "command_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "equipment_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "type": "string"
    },
    "arguments": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    }
  }
}
